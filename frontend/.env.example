# The frontend needs no configuration by default.
# In development Vite proxies /api, /uploads, /sitemap.xml and /robots.txt to the API.
# Change the proxy target if the API is not on http://localhost:4000:
# VITE_API_PROXY=http://localhost:4000

# Separate frontend/backend production deployment:
# VITE_API_BASE_URL=https://your-api.example.com
