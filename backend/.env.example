# ─── Server ───
NODE_ENV=development
PORT=4000
# Public URL of the storefront (used for CORS, emails, sitemap, payment callbacks)
CLIENT_URL=http://localhost:5173

# ─── Database ───
# Default points at the bundled dev PostgreSQL started by `npm run db:start` (port 5433).
# To use your own PostgreSQL instead, change this URL and skip `db:start`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/shophub?schema=public
EMBEDDED_DB_PORT=5433

# ─── Auth ───
# `npm run setup` replaces these placeholders with random secrets.
JWT_SECRET=__GENERATE__
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ─── Payments ───
# mock     → built-in test gateway (development only, no real money)
# razorpay → real Razorpay checkout (UPI, cards, net banking, wallets)
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOCK_GATEWAY_SECRET=__GENERATE__

# ─── File storage ───
# local | cloudinary
STORAGE_PROVIDER=local
# Where "local" stores files. Defaults to backend/uploads; point it at a persistent disk in production.
UPLOAD_DIR=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=shophub

# ─── Email (optional) ───
# Leave SMTP_HOST empty to log emails to the console and the email_logs table instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ShopHub <no-reply@shophub.local>"

# ─── Seed admin ───
SEED_ADMIN_EMAIL=admin@shophub.local
SEED_ADMIN_PASSWORD=Admin@12345
